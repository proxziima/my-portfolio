DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=YOUR_SHARED_REVALIDATE_SECRET
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_SECRET_HERE
# Bearer secret for GET /api/twin/redact-terms. The same value is shared with web and agents
# (TWIN_REDACT_SECRET in apps/web and apps/agents). Generate with `openssl rand -hex 32`.
TWIN_REDACT_SECRET=YOUR_SHARED_TWIN_REDACT_SECRET

# --- PostHog (analytics, replay, web vitals, errors, LLM traces) ---
# Public project token (phc_…). Blank disables all capture (dev, tests, CI).
POSTHOG_PROJECT_TOKEN=
# PostHog Cloud region: us or eu.
POSTHOG_REGION=us
