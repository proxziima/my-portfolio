# Portfolio twin agent (apps/agents). Copy to `.env` and fill in; `eve dev` and `bun run` load it.
# The schema is `agentsEnvSchema` in packages/twin/src/env.ts: it is parsed on first use and one error
# lists every bad variable. Required values are left empty here: fill every one. Commented-out lines
# are optional and show their default; uncomment one only to override it. Keep them commented rather
# than empty: an empty TWIN_MODEL_FALLBACKS disables the fallback chain (agent/lib/models.ts).
# Generate random secrets with `openssl rand -hex 32`.
# Production values live in Easypanel (template: .env.deploy.example, wiring: docker-compose.yml).

# --- Databases (this machine: Postgres 17 in WSL on 127.0.0.1:5433, never `localhost`) ---
# The twin schema (conversations, approvals, spend...). Shared with web: the BFF and the agent must
# point at the same database, because the BFF writes session ownership the agent reads.
# Use `twin` behind the web BFF; `twin_eval` keeps throwaway TUI runs out of the dev data.
TWIN_DATABASE_URL=postgres://twin:twin@127.0.0.1:5433/twin
# eve's durable Workflow world (@workflow/world-postgres). Agents only. Same database is fine:
# the world keeps its tables in its own schemas (workflow, graphile_worker).
WORKFLOW_POSTGRES_URL=postgres://twin:twin@127.0.0.1:5433/twin

# --- Model (OpenRouter) ---
# OpenRouter dashboard > Keys. Agents only. Give the key a credit limit there as well.
OPENROUTER_API_KEY=
# Optional OpenRouter model ids; the defaults are MODEL_DEFAULTS in packages/twin/src/env.ts.
# TWIN_MODEL=anthropic/claude-sonnet-5.5
# Comma-separated fallback chain, sent as OpenRouter's `models` routing after TWIN_MODEL.
# TWIN_MODEL_FALLBACKS=deepseek/deepseek-v4.1-flash
# Context window of TWIN_MODEL in tokens (OpenRouter models aren't in eve's catalog).
# TWIN_MODEL_CONTEXT_TOKENS=1000000
# Cheap model for the abuse gate and the call-intent label.
# TWIN_CLASSIFIER_MODEL=deepseek/deepseek-v4.1-flash
# Optional timeouts (ms). The intent label runs after the reply; the abuse gate runs before it and
# fails open (verdict "ok") when it times out.
# TWIN_CLASSIFIER_TIMEOUT_MS=4000
# TWIN_ABUSE_TIMEOUT_MS=1500

# --- Secrets shared with other apps ---
# Shared with web: verifies the BFF's 60-second visitor JWT (HS256, at least 32 characters).
TWIN_JWT_SECRET=
# Shared with web: marker at the top of every system prompt; the BFF replaces any reply containing
# it. At least 16 characters.
TWIN_PROMPT_CANARY=
# Shared with web and cms: bearer for the CMS's GET /api/twin/redact-terms (at least 32 characters).
TWIN_REDACT_SECRET=
# Agents only: HMAC key for the one-way hash of a volunteered visitor email (at least 32 characters).
TWIN_STABLE_KEY_SECRET=

# --- Payload CMS ---
# The CMS origin. The agent fetches the redaction rules from it for the stored transcript.
# Compose uses the internal http://cms:3001.
CMS_URL=http://localhost:3001
# Payload MCP endpoint (Streamable HTTP). Compose uses http://cms:3001/api/mcp.
PAYLOAD_MCP_URL=http://localhost:3001/api/mcp
# CMS admin > MCP > API Keys. Agents only. Enable ONLY twinIdentity, twinSearch and twinDisclose:
# the generic collection tools would read every disclosure tier.
PAYLOAD_MCP_API_KEY=

# --- Google Calendar free/busy (check_availability) ---
# Service account JSON key, base64 in one line (`base64 -w0 key.json`). Agents only.
# The owner's calendar must be shared with its client_email as "See only free/busy".
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Calendar > Settings > Integrate calendar > Calendar ID.
GOOGLE_CALENDAR_ID=
# IANA zone of the owner, e.g. America/Sao_Paulo. Validated at startup.
OWNER_TIMEZONE=America/Sao_Paulo

# --- Cal.com (booking dialog and webhook) ---
# Event to embed: "<user>/<event-slug>".
CAL_LINK=
# Optional, only for self-hosted Cal.
# CAL_ORIGIN=https://cal.com
# CAL_EMBED_SCRIPT_URL=https://app.cal.com/embed/embed.js
# The secret set on the Cal.com webhook (Settings > Developer > Webhooks). Agents only. 32+ characters.
CAL_WEBHOOK_SECRET=
# Agents only: signs the bookingRef the embed passes to Cal.com as metadata. 32+ characters.
TWIN_BOOKING_REF_SECRET=

# --- Telegram (owner approvals) ---
# Optional Bot API base URL; the offline evals point it at a local stub.
# TELEGRAM_API_BASE=https://api.telegram.org
# @BotFather token, "<digits>:<token>". Agents only.
TELEGRAM_BOT_TOKEN=
# Chosen by you, 16-256 characters of A-Z a-z 0-9 _ -. Pass the same value as `secret_token` to
# setWebhook; Telegram sends it back on every update. Agents only.
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user id (e.g. from @userinfobot). Send /start to the bot once first, or
# Telegram refuses the approval messages and every approval expires.
TELEGRAM_OWNER_USER_ID=
# How long an approval waits for the owner before it auto-denies: <n>s, <n>m or <n>h.
# TWIN_APPROVAL_TIMEOUT=15m

# --- Web search (web_search tool) ---
# exa.ai dashboard > API Keys. Agents only.
EXA_API_KEY=
