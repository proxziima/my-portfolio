CMS_URL=http://localhost:3001
# The CMS admin's origin as the browser sees it (Live Preview checks postMessage against it). Defaults to CMS_URL.
NEXT_PUBLIC_CMS_URL=http://localhost:3001
REVALIDATE_SECRET=YOUR_SHARED_REVALIDATE_SECRET
# Must equal PREVIEW_SECRET in apps/payload/.env (the CMS puts it in the Preview button URL)
PREVIEW_SECRET=YOUR_SHARED_PREVIEW_SECRET
