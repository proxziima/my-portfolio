# Production variables for docker-compose.yml (Easypanel: the Compose service's Environment tab).
# Generate each secret with:  openssl rand -hex 32
# Never reuse the development values from apps/payload/.env.

# Public origins, exactly as the browser sees them: https, no trailing slash, no path.
WEB_PUBLIC_URL=https://example.com
CMS_PUBLIC_URL=https://cms.example.com

# Parent domain shared by both origins, with a leading dot. The admin cookie is set on it so the
# web app can read it for draft preview and live preview. Leave empty to keep the cookie on the CMS host
# (preview then answers 403 in production).
COOKIE_DOMAIN=.example.com

# Encrypts Payload's auth tokens. Changing it signs every editor out.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# Shared by cms and web: the CMS sends it with each revalidation, the web checks it.
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32

# Shared by cms and web: the CMS puts it in the post Preview URL, the web checks it.
PREVIEW_SECRET=replace-with-openssl-rand-hex-32

# Optional: lets an external cron call the jobs endpoint with `Authorization: Bearer <CRON_SECRET>`.
# Scheduled publishing already runs inside the CMS every minute without it.
CRON_SECRET=replace-with-openssl-rand-hex-32

# --- Portfolio twin (services: postgres, agents, web, cms) ---

# Twin Postgres credentials (also the Workflow world's database). Pick any user; generate the password.
TWIN_PG_USER=twin
TWIN_PG_PASSWORD=replace-with-openssl-rand-hex-32

# OpenRouter dashboard > Keys: the model key the agent calls.
OPENROUTER_API_KEY=replace-with-openrouter-key
# Optional model overrides (OpenRouter ids). Leave empty for the defaults in packages/twin/src/env.ts.
TWIN_MODEL=
TWIN_MODEL_FALLBACKS=
TWIN_MODEL_CONTEXT_TOKENS=
# Light and deep routing tiers (model ids and their context windows).
TWIN_MODEL_LIGHT=
TWIN_MODEL_LIGHT_CONTEXT_TOKENS=
TWIN_MODEL_DEEP=
TWIN_MODEL_DEEP_CONTEXT_TOKENS=
TWIN_CLASSIFIER_MODEL=
TWIN_INTENT_MODEL=
# Optional timeouts in milliseconds, and the owner approval window (for example 15m). Empty uses defaults.
TWIN_CLASSIFIER_TIMEOUT_MS=
TWIN_ABUSE_TIMEOUT_MS=
TWIN_APPROVAL_TIMEOUT=

# Shared by web and agents: web signs the visitor token, the agent verifies it.
TWIN_JWT_SECRET=replace-with-openssl-rand-hex-32
# Web only: signs the visitor session cookie.
TWIN_COOKIE_SECRET=replace-with-openssl-rand-hex-32
# Shared by web and agents: a leaked system prompt is detected by this marker (at least 16 characters).
TWIN_PROMPT_CANARY=replace-with-openssl-rand-hex-16
# Agents only: derives the stable per-visitor key.
TWIN_STABLE_KEY_SECRET=replace-with-openssl-rand-hex-32
# Shared by cms, web and agents: authenticates the redact-terms endpoint.
TWIN_REDACT_SECRET=replace-with-openssl-rand-hex-32
# Web only: the twin's daily spend cap in USD.
TWIN_DAILY_SPEND_USD=5

# CMS admin > API Keys (MCP): the key the agent uses to read portfolio content.
PAYLOAD_MCP_API_KEY=replace-with-payload-api-key

# Google Cloud Console > IAM > Service accounts > Keys: the JSON key, base64-encoded in one line
# (base64 -w0 key.json). Share the owner's calendar with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-base64-service-account-json
# Google Calendar > Settings > Integrate calendar: the Calendar ID.
GOOGLE_CALENDAR_ID=you@example.com
# IANA zone of the owner's calendar, for example America/Sao_Paulo.
OWNER_TIMEZONE=America/Sao_Paulo

# Cal.com event URL path: <user>/<event-slug>.
CAL_LINK=user/event-slug
# Optional: only for self-hosted Cal. Empty uses https://cal.com and its official embed script.
CAL_ORIGIN=
CAL_EMBED_SCRIPT_URL=
# Cal.com > Settings > Developer > Webhooks: the secret you set on the webhook.
CAL_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# Signs booking references handed to the visitor.
TWIN_BOOKING_REF_SECRET=replace-with-openssl-rand-hex-32

# Telegram @BotFather: the bot token. Optional TELEGRAM_API_BASE only for a local Bot API server.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_API_BASE=
# Chosen by you (16-256 characters of A-Z a-z 0-9 _ -): sent back by Telegram on every webhook call.
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
# Your numeric Telegram user id (@userinfobot). Send /start to the bot once, or approvals expire.
TELEGRAM_OWNER_USER_ID=123456789

# exa.ai dashboard > API Keys: web search for the agent.
EXA_API_KEY=replace-with-exa-key
