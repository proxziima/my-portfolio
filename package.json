{
  "name": "my-portfolio",
  "version": "0.0.1",
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.10"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --concurrency=1",
    "infra": "bun scripts/infra.ts up",
    "infra:down": "bun scripts/infra.ts down",
    "infra:status": "bun scripts/infra.ts status"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
